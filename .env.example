# Copy this file to .env and replace placeholders. Never commit .env.

# PostgreSQL connection string (SQLAlchemy/psycopg2 format)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# Schema name assigned by the instructor (must be a valid SQL identifier)
DB_SCHEMA=your_schema_name

# JWT signing secret — use a long random string in production
SECRET_KEY=replace-with-a-strong-secret-key

# JWT algorithm (default used by app if omitted: HS256)
ALGORITHM=HS256

# Access token lifetime in minutes (default used by app if omitted: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
